# ============================================================
# AURA Mirror — Server (Express + MongoDB) .gitignore
# ============================================================

# Dependencies
node_modules/

# Environment / Secrets ⚠️ NEVER commit these
.env
.env.local
.env.development
.env.production
.env.staging

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime
*.pid
*.pid.lock
pids/

# OS generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor / IDE
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Vercel
.vercel/

# Uploads / temp files (if applicable)
uploads/
tmp/
