# ─── Server Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# Port for local development (Vercel ignores this)
PORT=5000

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/aura-mirror

# Allowed frontend origin for CORS
# Local dev:   http://localhost:5173
# Production:  https://your-client.vercel.app
CLIENT_ORIGIN=http://localhost:5173
